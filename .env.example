# backend/.env
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/samfit
JWT_SECRET=            # long random string: openssl rand -hex 32
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
AI_API_KEY=            # Anthropic API key (server only)
AI_MODEL=              # e.g. a vision-capable Claude model name from your Anthropic console
CLOUDINARY_CLOUD_NAME= # optional: photos are analysed even without storage
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_DEMO=false
# frontend/.env
VITE_API_URL=http://localhost:4000
